# ============ 应用配置 ============
APP_NAME=Growth Mark
APP_ENV=development
DEBUG=true

# ============ 数据库配置 ============
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=growth_mark

# ============ Redis 配置 ============
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============ JWT 配置 ============
JWT_SECRET_KEY=please-change-this-to-a-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============ 阿里云 OSS 配置 ============
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_CDN_DOMAIN=

# ============ 短信服务配置 ============
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=

# ============ AI 服务配置 ============
AI_PROVIDER=qwen
AI_API_KEY=
AI_MODEL=qwen-vl-max
AI_BASE_URL=https://dashscope.aliyuncs.com/api/v1

# ============ Celery 配置 ============
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ============ Sentry 配置（可选，留空则跳过） ============
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ============ 日志配置 ============
LOG_LEVEL=INFO
LOG_DIR=logs
SLOW_REQUEST_THRESHOLD=1.0

# ============ CORS 配置 ============
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
